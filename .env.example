# Credenciais do app privado da SP-API (Seller Central > Apps e Serviços > Desenvolver aplicativos)
SPAPI_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxx
SPAPI_CLIENT_SECRET=amzn1.oa2-cs.v1.xxxxxxxx
SPAPI_REFRESH_TOKEN=Atzr|xxxxxxxx

# Região do endpoint: na (EUA, Canadá, México, Brasil), eu (Europa, Oriente Médio, Índia) ou fe (Japão, Austrália, Singapura)
SPAPI_REGION=na

# Marketplace(s) padrão, separados por vírgula. Brasil = A2Q3Y263D00KWC, EUA = ATVPDKIKX0DER
SPAPI_MARKETPLACE_IDS=A2Q3Y263D00KWC

# Pasta onde os relatórios baixados são salvos
SPAPI_REPORTS_DIR=./relatorios

# true para usar o sandbox da SP-API (dados fictícios)
SPAPI_SANDBOX=false
